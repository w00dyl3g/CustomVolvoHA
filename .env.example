# Copy to .env and fill in your values:  cp .env.example .env
# NEVER commit the real .env — it contains secrets.

# --- Volvo Developer Portal: API application keys (from your account page) ---
apikeyprimary=
apikeysecondary=

# --- OAuth2 (from publishing the application, see README step 2) ---
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=http://localhost:3000/callback
# Read-only scopes for the Connected Vehicle API v2 (validated).
SCOPES=openid conve:vehicle_relation conve:battery_charge_level conve:brake_status conve:command_accessibility conve:commands conve:diagnostics_engine_status conve:diagnostics_workshop conve:engine_status conve:environment conve:doors_status conve:lock_status conve:windows_status conve:tyre_status conve:odometer_status conve:fuel_status conve:trip_statistics conve:warnings
# To enable remote commands (lock/unlock/climate), also append:
# conve:lock conve:unlock conve:climatization_start_stop conve:honk_flash

# Optional: pin a specific vehicle instead of auto-listing
# VIN=

# --- Home Assistant push (ha_push.py) ---
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# --- Command server / actuators (command_server.py) ---
COMMAND_TOKEN=
COMMAND_PORT=8099

# --- Filled automatically by oauth_login.py / token_manager.py ---
# ACCESS_TOKEN=
# TOKEN_EXPIRY=
# REFRESH_TOKEN=
